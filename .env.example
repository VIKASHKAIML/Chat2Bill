# =========================================================================
# Voice Billing & SmartPO Studio - Unified AI Configuration
# =========================================================================

# Application Server Port
PORT=3000

# =========================================================================
# 1. Google Gemini AI (SmartPO Multi-Image & PO Extractor Engine)
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
# =========================================================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# =========================================================================
# 2. Groq Cloud AI (High-Speed Whisper Voice Recognition & LLM Engine)
# Get your free Groq API key from: https://console.groq.com/keys
# =========================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# =========================================================================
# 3. Optional OpenAI-Compatible Providers (Together AI, DeepSeek, Local Ollama)
# =========================================================================
# TOGETHER_API_KEY=your_together_ai_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
# =========================================================================
# 4. Optional OCR Engines (Jina AI Cloud, Hugging Face, OCR.space)
# =========================================================================
# JINA_API_KEY=jina_your_jina_key_here
# HF_TOKEN=hf_your_huggingface_token_here
# OCR_SPACE_API_KEY=helloworld

